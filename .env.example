# ---- Your fixed personal details (never touched by the AI) ----
FULL_NAME="Jane Doe"
HEADLINE="Senior Software Engineer"
PHONE="+61 400 000 000"
EMAIL="jane.doe@example.com"
LINKEDIN="linkedin.com/in/janedoe"
LOCATION="Sydney, Australia"

# ---- Vertex AI (Gemini) settings ----
# Your Google Cloud project id (required).
GOOGLE_CLOUD_PROJECT="my-gcp-project"
# Vertex region. us-central1 has the widest model availability.
GOOGLE_CLOUD_LOCATION="us-central1"
# Any Gemini model available in Vertex.
GEMINI_MODEL="gemini-2.5-flash"

# ---- Vertex authentication ----
# Point to a service-account key file, OR leave unset and run:
#   gcloud auth application-default login
# GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/service-account.json"

# ---- App login (RBAC) ----
# Secret used to sign session cookies. CHANGE THIS to a long random string.
FLASK_SECRET_KEY="change-me-to-a-long-random-string"
# The default admin account, created once on first run. Log in, then change it
# and add client accounts from the Users page. CHANGE THESE.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin"

# ---- Outreach sender (Outreach page, admin only) ----
# The mailbox every outreach email is sent from. Gmail requires an APP PASSWORD
# (Google Account > Security > 2-Step Verification > App passwords) - your normal
# account password will be rejected.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="you@gmail.com"
SMTP_PASSWORD="abcd efgh ijkl mnop"
# What recipients see. SMTP_SENDER defaults to SMTP_USER; most providers refuse
# to send as an address you don't own.
SMTP_SENDER="you@gmail.com"
SMTP_SENDER_NAME="Your Name"
# Set to 1 only for implicit-TLS ports (465). Port 587 uses STARTTLS - leave unset.
SMTP_SSL=""
# Set to "doh" if sending times out behind a VPN (e.g. Astrill) that fakes DNS
# answers for mail servers. The server address is then looked up over Google
# DNS-over-HTTPS; its TLS certificate is still verified. Leave empty otherwise.
SMTP_RESOLVER=""

# The Outreach page reads and writes the Google Sheet with a service-account key.
# It uses sheets-sa.json next to app.py if present (a key from any project with
# the Google Sheets API enabled - no billing needed), else the Vertex key above.
# Share the sheet with that key's client_email as an Editor.
# GOOGLE_SHEETS_CREDENTIALS="sheets-sa.json"
