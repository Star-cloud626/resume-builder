# ---- Your fixed personal details (never touched by the AI) ----
FULL_NAME="Jane Doe"
HEADLINE="Senior Software Engineer"
PHONE="+61 400 000 000"
EMAIL="jane.doe@example.com"
LINKEDIN="linkedin.com/in/janedoe"
LOCATION="Sydney, Australia"

# ---- Vertex AI (Gemini) settings ----
# Your Google Cloud project id (required).
GOOGLE_CLOUD_PROJECT="my-gcp-project"
# Vertex region. us-central1 has the widest model availability.
GOOGLE_CLOUD_LOCATION="us-central1"
# Any Gemini model available in Vertex.
GEMINI_MODEL="gemini-2.5-flash"

# ---- Authentication ----
# Point to a service-account key file, OR leave unset and run:
#   gcloud auth application-default login
# GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/service-account.json"
